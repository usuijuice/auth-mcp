{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID"],
  },
  "observability": {
    "enabled": false,
  },
}
