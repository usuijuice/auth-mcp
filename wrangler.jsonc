{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "cd18baa82ed144e3a4b6a84a86d895d8",
    },
  ],
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "MCP_SERVER_URL"],
  },
  "observability": {
    "enabled": false,
  },
}
