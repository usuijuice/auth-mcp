{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm worker:check",
    "cf-typegen": "wrangler types",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
